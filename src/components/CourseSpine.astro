---
// The twelve weeks, in the order that is the argument.
//
// The home page has always claimed that the order is not negotiable and that
// week six is impossible without week two. A prospective student reading that
// has to take it on trust: nothing on the page shows what each week adds or
// which film it hangs on.
//
// This is that claim as the schedule. Every row is read from the lecture
// frontmatter — the subsystem and the screening — so the spine cannot say one
// thing while the week pages say another, and a week added later appears here
// without anybody remembering to update a list. Which weeks a week depends on
// is the week page's own business: "Builds on" and "Feeds into" say it there,
// where there is room to name them.
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";

interface Screening {
  title: string;
  year: number;
}

const isScreening = (value: unknown): value is Screening =>
  typeof value === "object" &&
  value !== null &&
  typeof (value as Screening).title === "string" &&
  typeof (value as Screening).year === "number";

const lectures = await getPublishedCollection("lectures");

const weeks = lectures
  .map((lecture) => {
    const extra = lecture.data as { subsystem?: unknown; screening?: unknown };
    return {
      slug: lecture.id,
      week: lecture.data.week,
      subsystem: typeof extra.subsystem === "string" ? extra.subsystem : "the crit",
      screening: isScreening(extra.screening) ? extra.screening : null,
    };
  })
  .sort((a, b) => a.week - b.week);
---

<section class="spine" aria-labelledby="spine-heading">
  <h2 id="spine-heading">The twelve weeks</h2>

  <ol>
    {
      weeks.map((entry) => (
        <li>
          <a class="spine-week" href={withBase(`/lectures/${entry.slug}/`)}>
            Week {entry.week}
          </a>
          <span class="spine-subsystem">{entry.subsystem}</span>
          <span class="spine-film">
            {entry.screening ? (
              <>
                <cite>{entry.screening.title}</cite> ({entry.screening.year})
              </>
            ) : (
              <span class="spine-nofilm">no screening — you present</span>
            )}
          </span>
        </li>
      ))
    }
  </ol>

  <p class="spine-note">
    Eleven films, all compulsory. Each week builds on what came before, so the decisions you
    make early in the course will shape the language you develop later.
  </p>
</section>

<style>
  /* Brand tokens only, so the block follows the palette into dark mode. */
  .spine h2 {
    margin-block-end: 0.75rem;
  }

  .spine ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--at-divider, currentColor);
  }

  .spine li {
    display: grid;
    gap: 0.1rem 1rem;
    padding-block: 0.6rem;
    border-block-end: 1px solid var(--at-divider, currentColor);
    /* Phone: week and subsystem share a line, then the film. */
    grid-template-areas:
      "week subsystem"
      "film film";
    grid-template-columns: auto 1fr;
  }

  @media (min-width: 45rem) {
    .spine li {
      grid-template-areas: "week subsystem film";
      grid-template-columns: 5rem 11rem 1fr;
      align-items: baseline;
      gap: 1rem;
    }
  }

  .spine-week {
    grid-area: week;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .spine-subsystem {
    grid-area: subsystem;
  }

  .spine-film {
    grid-area: film;
    font-size: var(--at-font-size-sm, 0.875rem);
  }

  .spine-nofilm {
    opacity: 0.7;
  }

  .spine-note {
    margin-block-start: 1rem;
    font-size: var(--at-font-size-sm, 0.875rem);
    opacity: 0.85;
  }
</style>
