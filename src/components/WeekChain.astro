---
// What a teaching week needs, and what needs it.
//
// The course's claim is that the order is the argument: week 6 cannot be run
// before week 2, because you cannot borrow a word into a language whose sounds
// you have not chosen yet. That claim was prose on the home page and nowhere in
// the data — every week's `related:` pointed only at the week before it, so the
// site asserted a chain and shipped a straight line.
//
// `requires:` is the real edge. It rides the lecture schema's passthrough (like
// `screening` and `subsystem`) rather than being declared in
// `src/content.config.ts`, so it arrives untyped and is narrowed here.
// `spec/subsystem-chain.test.ts` holds it to being acyclic, backward-pointing
// and connected.
//
// "Feeds into" is never authored: it is `requires:` inverted across every
// lecture, so the two directions cannot disagree.
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";

interface Props {
  /** The lecture being rendered, by collection id — "week-03". */
  id: string;
}

const { id } = Astro.props;

const asRefs = (value: unknown): string[] =>
  Array.isArray(value) ? value.filter((ref): ref is string => typeof ref === "string") : [];

/** A `requires:` entry is a bare slug or a `lectures/<slug>` ref; both resolve to the slug. */
const toSlug = (ref: string) => ref.replace(/^lectures\//, "");

const lectures = await getPublishedCollection("lectures");

interface Link {
  slug: string;
  week: number;
  subsystem: string;
  title: string;
}

const bySlug = new Map(lectures.map((lecture) => [lecture.id, lecture]));

const toLink = (slug: string): Link | null => {
  const lecture = bySlug.get(slug);
  if (!lecture) return null;
  const { week, title } = lecture.data;
  const subsystem = (lecture.data as { subsystem?: unknown }).subsystem;
  return {
    slug,
    week,
    title,
    subsystem: typeof subsystem === "string" ? subsystem : "",
  };
};

const byWeek = (a: Link, b: Link) => a.week - b.week;

const buildsOn = asRefs((bySlug.get(id)?.data as { requires?: unknown } | undefined)?.requires)
  .map(toSlug)
  .map(toLink)
  .filter((link): link is Link => link !== null)
  .sort(byWeek);

const feedsInto = lectures
  .filter((lecture) =>
    asRefs((lecture.data as { requires?: unknown }).requires)
      .map(toSlug)
      .includes(id),
  )
  .map((lecture) => toLink(lecture.id))
  .filter((link): link is Link => link !== null)
  .sort(byWeek);
---

{
  (buildsOn.length > 0 || feedsInto.length > 0) && (
    <nav class="chain" aria-label="Where this week sits in the build">
      {buildsOn.length > 0 && (
        <div class="chain-arm">
          <h2>Builds on</h2>
          <ul>
            {buildsOn.map((link) => (
              <li>
                <a href={withBase(`/lectures/${link.slug}/`)}>
                  <span class="chain-week">Week {link.week}</span>
                  <span class="chain-subsystem">{link.subsystem}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {feedsInto.length > 0 && (
        <div class="chain-arm">
          <h2>Feeds into</h2>
          <ul>
            {feedsInto.map((link) => (
              <li>
                <a href={withBase(`/lectures/${link.slug}/`)}>
                  <span class="chain-week">Week {link.week}</span>
                  <span class="chain-subsystem">{link.subsystem}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </nav>
  )
}

<style>
  /* Brand tokens only, so the block follows the palette into dark mode. */
  .chain {
    display: grid;
    gap: 1rem 2.5rem;
    margin-block: 1.5rem 2rem;
    padding-block: 0.9rem;
    border-block: 1px solid var(--at-border, currentColor);
  }

  @media (min-width: 45rem) {
    .chain {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .chain-arm h2 {
    margin-block: 0 0.5rem;
    font-size: var(--at-font-size-xs, 0.75rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--at-accent, currentColor);
  }

  .chain-arm ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
  }

  .chain-arm a {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .chain-week {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* The subsystem is the reason for the edge, so it is set apart from the label. */
  .chain-subsystem {
    font-size: var(--at-font-size-sm, 0.875rem);
    opacity: 0.75;
  }
</style>
