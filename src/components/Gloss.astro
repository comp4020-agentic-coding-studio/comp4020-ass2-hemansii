---
// An interlinear gloss of the example language.
//
// Workshop 4 spends its first hour on exactly this: "three lines — the words,
// the morphemes, the translation". The course asks students to produce one, so
// the site should be able to show one, and show the same sentence changing as
// later weeks add subsystems to it.
//
// `example:` rides the lecture schema's passthrough, like `screening` and
// `subsystem`, so it arrives untyped and is narrowed here. Lectures are `.md`,
// which is why this is frontmatter rendered by the template rather than a
// component dropped into the body — and it means the glosses reach the course
// API, where `spec/example-language.test.ts` can hold them to the phoneme
// inventory.
//
// Alignment is the whole point of the format, so a mismatch between the two
// lines is a build error rather than a page that renders crooked. Words wrap as
// units: a form is never separated from the morphemes underneath it, which is
// what keeps the block readable at 390px.
import { withBase } from "astro-theme-university/url";
import { GLOSS_ABBREVIATIONS } from "../lib/example-language";

interface GlossLine {
  label?: string;
  words: string;
  morphemes: string;
  translation: string;
  note?: string;
}

interface Props {
  example?: unknown;
  /** Names the week in the build error, so a crooked gloss is easy to find. */
  id: string;
}

const { example, id } = Astro.props;

const isGlossLine = (value: unknown): value is GlossLine => {
  if (typeof value !== "object" || value === null) return false;
  const line = value as GlossLine;
  return (
    typeof line.words === "string" &&
    typeof line.morphemes === "string" &&
    typeof line.translation === "string"
  );
};

const lines: GlossLine[] = Array.isArray(example) ? example.filter(isGlossLine) : [];

/** A morpheme glossed in capitals is grammatical; anything else is a plain sense. */
const isGrammatical = (part: string) => /^[A-Z][A-Z0-9.]*$/.test(part);

const align = (line: GlossLine, index: number) => {
  const forms = line.words.trim().split(/\s+/);
  const glosses = line.morphemes.trim().split(/\s+/);

  if (forms.length !== glosses.length) {
    throw new Error(
      `${id}: example[${index}] has ${forms.length} words but ${glosses.length} glosses — ` +
        `an interlinear gloss has to line up word for word.`,
    );
  }

  return forms.map((form, wordIndex) => {
    const gloss = glosses[wordIndex] as string;
    const formParts = form.split("-");
    const glossParts = gloss.split("-");

    if (formParts.length !== glossParts.length) {
      throw new Error(
        `${id}: example[${index}] splits "${form}" into ${formParts.length} morphemes but ` +
          `glosses it with ${glossParts.length} ("${gloss}") — the hyphens have to correspond.`,
      );
    }

    return { form, glossParts };
  });
};

const aligned = lines.map((line, index) => ({ line, words: align(line, index) }));
---

{
  aligned.length > 0 && (
    <section class="example" aria-labelledby={`example-${id}`}>
      <h2 id={`example-${id}`}>Worked example</h2>

      <p class="example-lede">
        The course's language, not yours. Its inventory is in{" "}
        <a href={withBase("/lectures/week-02/")}>week 2</a>.
      </p>

      {aligned.map(({ line, words }) => (
        <figure>
          {line.label && <figcaption class="example-label">{line.label}</figcaption>}
          <div class="example-lines">
            {words.map(({ form, glossParts }) => (
              <span class="example-word">
                <span class="example-form">{form}</span>
                <span class="example-gloss">
                  {glossParts.map((part, partIndex) => (
                    <>
                      {partIndex > 0 && <span aria-hidden="true">-</span>}
                      {isGrammatical(part) && GLOSS_ABBREVIATIONS[part] ? (
                        <abbr title={GLOSS_ABBREVIATIONS[part]}>{part}</abbr>
                      ) : (
                        part
                      )}
                    </>
                  ))}
                </span>
              </span>
            ))}
          </div>
          <p class="example-translation">‘{line.translation}’</p>
          {line.note && <p class="example-note">{line.note}</p>}
        </figure>
      ))}
    </section>
  )
}

<style>
  /* Brand tokens only, so the block follows the palette into dark mode. */
  .example {
    margin-block: 2rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--at-border, currentColor);
    border-radius: var(--at-border-radius, 0);
    background: var(--at-bg-alt, transparent);
  }

  .example h2 {
    margin-block: 0 0.75rem;
    font-size: var(--at-font-size-xs, 0.75rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--at-accent, currentColor);
  }

  .example-lede {
    margin-block: 0 1rem;
    font-size: var(--at-font-size-sm, 0.875rem);
    opacity: 0.8;
  }

  .example figure {
    margin: 0;
  }

  .example figure + figure {
    margin-block-start: 1.5rem;
  }

  .example-label {
    margin-block-end: 0.5rem;
    font-size: var(--at-font-size-xs, 0.75rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  /*
   * Words wrap as units. Each one is a two-row stack, so the form always sits
   * directly above the morphemes that gloss it however narrow the screen gets.
   */
  .example-lines {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.5rem;
    font-family: var(--at-font-mono, monospace);
  }

  .example-word {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .example-form {
    white-space: nowrap;
  }

  .example-gloss {
    font-size: var(--at-font-size-sm, 0.875rem);
    white-space: nowrap;
    opacity: 0.8;
  }

  /* The convention is small capitals for grammatical glosses. */
  .example-gloss abbr {
    font-size: 0.85em;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-block-end: 1px dotted currentColor;
    cursor: help;
  }

  .example-translation {
    margin-block: 0.75rem 0;
    font-style: italic;
  }

  .example-note {
    margin-block: 0.5rem 0;
    font-size: var(--at-font-size-sm, 0.875rem);
    opacity: 0.8;
  }
</style>
