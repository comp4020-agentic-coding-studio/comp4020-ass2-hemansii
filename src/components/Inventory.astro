---
// The example language's phoneme inventory, as the IPA would print it.
//
// This is where the worked example is introduced, which is why it carries the
// framing: the course keeps a language of its own so every subsystem has
// something to point at, and it is not the one the student builds.
//
// The bilabial column is drawn and left empty. Deleting it would give a tidy
// chart of a small inventory; keeping it makes the design brief visible without
// a word of explanation — week 1 said a species with no lips cannot have /p/ or
// /b/, and this is that sentence as a table. The vowel chart makes the other
// half of the point, the half students miss: rounding is a lip gesture too, so
// every vowel here is unrounded, including the back one.
//
// Both charts are generated from `src/lib/example-language.ts`, the same module
// the glosses are checked against, so the chart and the sentences cannot drift.
import { withBase } from "astro-theme-university/url";
import {
  BACKNESSES,
  CONSONANTS,
  HEIGHTS,
  MANNERS,
  MORPHOLOGICAL_TYPE,
  PLACES,
  SYLLABLE_FORMULA,
  VOWELS,
  WORD_ORDER,
} from "../lib/example-language";

interface Props {
  /** The lecture's `inventory:` flag — only the phonology week prints this. */
  show?: unknown;
}

const { show } = Astro.props;

const consonantAt = (manner: string, place: string) =>
  CONSONANTS.filter((sound) => sound.manner === manner && sound.place === place);

const vowelAt = (height: string, backness: string) =>
  VOWELS.filter((sound) => sound.height === height && sound.backness === backness);

/** Romanisation is only worth printing where it differs from the IPA. */
const romanisation = (sound: { ipa: string; roman: string }) =>
  sound.roman === sound.ipa ? null : sound.roman;
---

{
  show && (
    <section class="inventory" aria-labelledby="inventory-heading">
      <h2 id="inventory-heading">The example language</h2>

      <p class="inventory-lede">
        This one is the course's, not yours. It is here so every subsystem has a worked example
        to point at, and it is the language you take apart in workshop 3. Yours starts from its
        own brief, and will not look like this.
      </p>

      <p class="inventory-lede">
        Its speakers have no lips. Everything below is downstream of that one line in the brief.
      </p>

      <figure>
        <figcaption>Consonants</figcaption>
        <div class="inventory-scroll">
          <table>
            <thead>
              <tr>
                <td />
                {PLACES.map((place) => (
                  <th scope="col">{place}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {MANNERS.map((manner) => (
                <tr>
                  <th scope="row">{manner}</th>
                  {PLACES.map((place) => (
                    <td>
                      {consonantAt(manner, place).map((sound) => (
                        <span class="phoneme">
                          <span class="phoneme-ipa">/{sound.ipa}/</span>
                          {romanisation(sound) && (
                            <span class="phoneme-roman">&#10216;{romanisation(sound)}&#10217;</span>
                          )}
                        </span>
                      ))}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </figure>

      <figure>
        <figcaption>Vowels</figcaption>
        <div class="inventory-scroll">
          <table>
            <thead>
              <tr>
                <td />
                {BACKNESSES.map((backness) => (
                  <th scope="col">{backness}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {HEIGHTS.map((height) => (
                <tr>
                  <th scope="row">{height}</th>
                  {BACKNESSES.map((backness) => (
                    <td>
                      {vowelAt(height, backness).map((sound) => (
                        <span class="phoneme">
                          <span class="phoneme-ipa">/{sound.ipa}/</span>
                          {romanisation(sound) && (
                            <span class="phoneme-roman">&#10216;{romanisation(sound)}&#10217;</span>
                          )}
                        </span>
                      ))}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </figure>

      <p class="inventory-note">
        The bilabial column is empty, and stays empty. So does every rounded vowel — rounding is
        done with the lips, which is the half of the constraint most people miss. The inventory is
        eight consonants and five vowels because that is what the script in week 8 can draw.
      </p>

      <dl class="inventory-facts">
        <div>
          <dt>Syllable</dt>
          <dd>{SYLLABLE_FORMULA}</dd>
        </div>
        <div>
          <dt>Morphology</dt>
          <dd>{MORPHOLOGICAL_TYPE}</dd>
        </div>
        <div>
          <dt>Word order</dt>
          <dd>{WORD_ORDER}</dd>
        </div>
      </dl>

      <p class="inventory-note">
        You can watch it work in <a href={withBase("/lectures/week-03/")}>week 3</a>, where the
        morphemes come apart, and in <a href={withBase("/lectures/week-11/")}>week 11</a>, where
        most of them stop being said at all.
      </p>
    </section>
  )
}

<style>
  /* Brand tokens only, so the block follows the palette into dark mode. */
  .inventory {
    margin-block: 2rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--at-border, currentColor);
    border-radius: var(--at-border-radius, 0);
    background: var(--at-bg-alt, transparent);
  }

  .inventory h2 {
    margin-block: 0 0.75rem;
    font-size: var(--at-font-size-xs, 0.75rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--at-accent, currentColor);
  }

  .inventory-lede {
    margin-block: 0 0.75rem;
  }

  .inventory figure {
    margin: 1.5rem 0 0;
  }

  .inventory figcaption {
    margin-block-end: 0.4rem;
    font-size: var(--at-font-size-xs, 0.75rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  /* A six-column chart does not fit 390px, so it scrolls rather than the page. */
  .inventory-scroll {
    overflow-x: auto;
  }

  /*
   * Width auto, against the theme's full-width default: a chart should be as
   * wide as its contents and no wider, or the browser distributes the spare
   * width by breaking the column labels down the middle.
   */
  .inventory table {
    width: auto;
    border-collapse: collapse;
    font-size: var(--at-font-size-sm, 0.875rem);
  }

  .inventory th,
  .inventory td {
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--at-divider, currentColor);
    text-align: center;
    vertical-align: middle;
  }

  /*
   * The labels wrap rather than holding the columns apart. At 390px a chart
   * wide enough to scroll shows the empty bilabial column and nothing else,
   * which is the one comparison the reader has to be able to make.
   */
  .inventory thead th,
  .inventory tbody th {
    font-weight: 400;
    font-size: var(--at-font-size-xs, 0.75rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.7;
    text-wrap: balance;
  }

  @media (max-width: 34rem) {
    .inventory th,
    .inventory td {
      padding: 0.3rem 0.15rem;
    }

    .inventory thead th,
    .inventory tbody th {
      font-size: 0.52rem;
      letter-spacing: 0;
    }

    .inventory table {
      font-size: 0.8rem;
    }

    /* Stacking the romanisation under the IPA halves the width of a cell. */
    .phoneme {
      flex-direction: column;
      gap: 0;
    }
  }

  .inventory tbody th {
    text-align: start;
  }

  /* The top-left corner of a chart labels nothing, so it carries no rule. */
  .inventory thead td {
    border: 0;
  }

  .phoneme {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    font-family: var(--at-font-mono, monospace);
    white-space: nowrap;
  }

  .phoneme-roman {
    font-size: 0.85em;
    opacity: 0.6;
  }

  .inventory-note {
    margin-block: 1rem 0;
    font-size: var(--at-font-size-sm, 0.875rem);
    opacity: 0.8;
  }

  .inventory-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-block: 1rem 0;
  }

  .inventory-facts div {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .inventory-facts dt {
    font-size: var(--at-font-size-xs, 0.75rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .inventory-facts dd {
    margin: 0;
    font-family: var(--at-font-mono, monospace);
  }
</style>
