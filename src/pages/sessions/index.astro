---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import heroImage from "../../assets/images/banner-workshops.avif";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
import "../../styles/hero.css";
---

<ContentLayout
  title={sessionLabels.plural}
  description={`The twelve-week teaching schedule: what happens in each ${sessionLabels.singular.toLowerCase()}, what to prepare, and what leaves the room.`}
  heroImage={heroImage}
  heroImageAlt="A row of people drawn in profile in black and gold on warm cream, facing alternately left and right, each with a speech bubble above them holding a few letters of the invented script — some bubbles hold a whole phrase, one holds a single letter, and they overlap each other"
  {...siteConfig}
>
  <p>
    Two hours on a Thursday, every week of semester. You arrive having watched
    the film and sat the lecture, and you leave with one subsystem of your
    language built and written down. Bring a printed IPA chart to the first
    four — a real one, on paper.
  </p>
  <SessionsGrid />
</ContentLayout>
