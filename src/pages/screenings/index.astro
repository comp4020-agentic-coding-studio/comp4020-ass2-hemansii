---
// Every film the course requires you to have watched, in the order it needs
// them.
//
// Eleven weeks each attach a film, and until now you could only find out which
// by opening eleven lecture pages. The Weekly Build Log asks what the film
// changed in your language, so a student planning a semester — or deciding
// whether to take the elective at all — needs the whole list in one place.
//
// Every row is read from the lecture frontmatter, so this page cannot name a
// film the week does not, and a week whose screening changes changes here too.
// `poster` is optional and rides the same passthrough: a week with one shows
// it, a week without falls back to a typographic card, so the page is never
// waiting on artwork to be worth reading.
import { getPublishedCollection } from "astro-course-university/content";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import heroImage from "../../assets/images/banner-screenings.avif";
import { formatCourseDate } from "../../lib/dates";
import { siteConfig } from "../../site-config";
import "../../styles/hero.css";

interface Screening {
  title: string;
  year: number;
  poster?: string;
  posterAlt?: string;
}

const isScreening = (value: unknown): value is Screening =>
  typeof value === "object" &&
  value !== null &&
  typeof (value as Screening).title === "string" &&
  typeof (value as Screening).year === "number";

const posters = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/posters/*.{avif,png,jpg,jpeg,webp}",
  { eager: true },
);

const lectures = await getPublishedCollection("lectures");

const screenings = lectures
  .map((lecture) => {
    const extra = lecture.data as { screening?: unknown; subsystem?: unknown };
    if (!isScreening(extra.screening)) return null;
    return {
      slug: lecture.id,
      week: lecture.data.week,
      date: lecture.data.date,
      lectureTitle: lecture.data.title,
      subsystem: typeof extra.subsystem === "string" ? extra.subsystem : "",
      film: extra.screening,
      poster: extra.screening.poster ? posters[extra.screening.poster]?.default : undefined,
    };
  })
  .filter((entry): entry is NonNullable<typeof entry> => entry !== null)
  .sort((a, b) => a.week - b.week);

/** A film required in more than one week is worth saying so on both. */
const timesShown = new Map<string, number>();
for (const entry of screenings) {
  const key = entry.film.title.toLowerCase();
  timesShown.set(key, (timesShown.get(key) ?? 0) + 1);
}
---

<ContentLayout
  title="Screenings"
  description={`All ${screenings.length} compulsory screenings, in the order the course needs them.`}
  heroImage={heroImage}
  heroImageAlt="A line drawing on warm cream of a film projector on a tripod at the left, throwing a wide gold beam across the room onto a pull-down screen at the right. On the screen, a half-lit moon hangs over two dark hills; underneath it runs a line of subtitles written in an invented script. Three people watch from seats in the foreground, one holding popcorn"
  {...siteConfig}
>
  <p>
    Attendance is a requirement, not a recommendation. The lecture assumes you have seen the
    film, the workshop assumes the lecture, and the Weekly Build Log asks what the film changed
    in your language — there is no version of that entry you can write from a synopsis. You do
    not have to come to the Monday screening specifically, but you do have to have watched it.
  </p>

  <ol class="films">
    {
      screenings.map((entry) => (
        <li>
          <div class="films-poster">
            {entry.poster ? (
              <img src={entry.poster.src} alt={entry.film.posterAlt ?? ""} loading="lazy" />
            ) : (
              <span class="films-week">{entry.week}</span>
            )}
          </div>
          <div class="films-detail">
            <h2>
              <cite>{entry.film.title}</cite> <span class="films-year">({entry.film.year})</span>
            </h2>
            <p class="films-meta">
              Week {entry.week} · {formatCourseDate(entry.date)}
              {entry.subsystem && <> · {entry.subsystem}</>}
              {(timesShown.get(entry.film.title.toLowerCase()) ?? 0) > 1 && (
                <> · screened twice</>
              )}
            </p>
            <p class="films-why">
              <a href={withBase(`/lectures/${entry.slug}/`)}>{entry.lectureTitle}</a>
            </p>
          </div>
        </li>
      ))
    }
  </ol>

  <p class="films-note">
    Week 12 has no film. It is the crit, and you are what is being shown.
  </p>
</ContentLayout>

<style>
  /* Brand tokens only, so the list follows the palette into dark mode. */
  .films {
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1px;
    background: var(--at-divider, currentColor);
    border-block: 1px solid var(--at-divider, currentColor);
  }

  .films li {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
    align-items: start;
    padding-block: 0.9rem;
    background: var(--at-bg, transparent);
  }

  @media (min-width: 45rem) {
    .films li {
      grid-template-columns: 6rem 1fr;
      gap: 1.5rem;
    }
  }

  /*
   * The poster slot keeps its shape whether or not there is a poster in it, so
   * the column does not jump about while the artwork is still being collected.
   */
  .films-poster {
    aspect-ratio: 2 / 3;
    display: grid;
    place-items: center;
    border: 1px solid var(--at-border, currentColor);
    border-radius: var(--at-border-radius, 0);
    background: var(--at-bg-alt, transparent);
    overflow: hidden;
  }

  .films-poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .films-week {
    font-size: 1.6rem;
    font-variant-numeric: tabular-nums;
    color: var(--at-accent, currentColor);
  }

  .films-detail h2 {
    margin-block: 0 0.2rem;
    font-size: var(--at-font-size-h4, 1.15rem);
  }

  .films-year {
    font-variant-numeric: tabular-nums;
  }

  .films-meta {
    margin-block: 0 0.35rem;
    font-size: var(--at-font-size-sm, 0.875rem);
    opacity: 0.75;
  }

  .films-why {
    margin-block: 0;
    font-size: var(--at-font-size-sm, 0.875rem);
  }

  .films-note {
    margin-block-start: 1.25rem;
    font-size: var(--at-font-size-sm, 0.875rem);
    opacity: 0.85;
  }
</style>
